# ==============================================================================
# CtrlLink Local Testing Environment Variables (.env.local.testing)
# Targets local services on the local machine instead of production endpoints.
# ==============================================================================

# Database Configuration (Local PostgreSQL)
# When running in Docker Compose, POSTGRES_HOST is postgres.
# When running backend natively on host machine, use POSTGRES_HOST=localhost.
POSTGRES_DB=CtrlLink
POSTGRES_USER=admin
POSTGRES_PASSWORD=admin
POSTGRES_PORT=5432
POSTGRES_HOST=postgres

# Redis Configuration (Local Redis)
# When running in Docker Compose, REDIS_HOST is redis.
# When running backend natively on host machine, use REDIS_HOST=localhost.
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_USERNAME=default
REDIS_SSL_ENABLED=false

# Backend Application Configuration (Local machine URLs)
APP_BASE_URL=http://localhost:8080
APP_FRONTEND_URL=http://localhost:3000
APP_ALLOWED_ORIGIN=http://localhost:3000,http://localhost:80,http://localhost:5173,http://localhost:8080,http://127.0.0.1:3000,http://127.0.0.1:8080
APP_URL_ID_BATCH_SIZE=100

# Security & Tokens
APP_JWT_SECRET=my-super-secret-key-that-is-at-least-256-bits-long-for-hs256
APP_JWT_EXPIRATION_MS=86400000
APP_ENCRYPTION_SECRET=my-ultra-secret-key-32-chars-long

# Google OAuth
GOOGLE_CLIENT_ID=671534648137-qi5mvbmdf3paikng3stn3dnosv2bv3rs.apps.googleusercontent.com

# Email (Gmail SMTP) Configuration
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=sujalagrawal2700@gmail.com
SPRING_MAIL_PASSWORD=xdae oroz jovu jjnr

# Logging Configuration (DEBUG, INFO, WARN, ERROR)
LOGGING_LEVEL_APP=DEBUG
LOGGING_LEVEL_ROOT=INFO

# Frontend Build Arguments (Pointing to local backend)
VITE_API_BASE_URL=http://localhost:8080
REDIRECT_VITE_API_BASE_URL=http://localhost:8080
VITE_GOOGLE_CLIENT_ID=671534648137-qi5mvbmdf3paikng3stn3dnosv2bv3rs.apps.googleusercontent.com
