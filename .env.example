# ==============================================================================
# CtrlLink Docker Environment Variables Example
# Copy this file to .env and adjust values as needed for your local or production setup.
# ==============================================================================

# Database Configuration
POSTGRES_DB=CtrlLink
POSTGRES_USER=admin
POSTGRES_PASSWORD=admin
POSTGRES_PORT=5432

# Redis Configuration
REDIS_PORT=6379

# Backend Application Configuration
APP_BASE_URL=http://localhost:8080
APP_FRONTEND_URL=http://localhost:3000
APP_ALLOWED_ORIGIN=http://localhost:3000
APP_JWT_SECRET=my-super-secret-key-that-is-at-least-256-bits-long-for-hs256
APP_ENCRYPTION_SECRET=my-ultra-secret-key-32-chars-long
GOOGLE_CLIENT_ID=671534648137-qi5mvbmdf3paikng3stn3dnosv2bv3rs.apps.googleusercontent.com

# Frontend Build Arguments
VITE_API_BASE_URL=http://localhost:8080
VITE_GOOGLE_CLIENT_ID=671534648137-qi5mvbmdf3paikng3stn3dnosv2bv3rs.apps.googleusercontent.com
