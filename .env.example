# ==============================================================================
# CtrlLink Docker Environment Variables Example
# Copy this file to .env and adjust values for your local or production setup.
# ==============================================================================

# Database Configuration
POSTGRES_DB=your_postgres_db_name
POSTGRES_USER=your_postgres_user
POSTGRES_PASSWORD=your_postgres_password
POSTGRES_PORT=5432

# Redis Configuration
# Local Docker Redis defaults:
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_USERNAME=default
REDIS_SSL_ENABLED=false
#
# For Upstash Redis (Cloud):
# REDIS_HOST=your-endpoint.upstash.io
# REDIS_PORT=6379
# REDIS_PASSWORD=your_upstash_password
# REDIS_USERNAME=default
# REDIS_SSL_ENABLED=true

# Backend Application Configuration
APP_BASE_URL=http://localhost:8080
APP_FRONTEND_URL=http://localhost:3000
APP_ALLOWED_ORIGIN=http://localhost:3000
APP_URL_ID_BATCH_SIZE=100

# Security & Tokens
APP_JWT_SECRET=your_jwt_secret_key_at_least_256_bits_long
APP_JWT_EXPIRATION_MS=86400000
APP_ENCRYPTION_SECRET=your_encryption_secret_key_32_chars

# Google OAuth
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com

# Email (Gmail SMTP) Configuration
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=your_gmail_username@gmail.com
SPRING_MAIL_PASSWORD=your_gmail_app_password

# Logging Configuration (DEBUG, INFO, WARN, ERROR)
LOGGING_LEVEL_APP=DEBUG
LOGGING_LEVEL_ROOT=INFO

# Frontend Build Arguments
VITE_API_BASE_URL=http://localhost:8080
REDIRECT_VITE_API_BASE_URL=http://localhost:8080
VITE_GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
