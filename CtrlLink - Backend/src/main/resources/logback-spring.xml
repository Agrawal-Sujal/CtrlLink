<?xml version="1.0" encoding="UTF-8"?>
<configuration scan="true" scanPeriod="30 seconds">

    <conversionRule conversionWord="clr" class="org.springframework.boot.logging.logback.ColorConverter" />
    <conversionRule conversionWord="wex" class="org.springframework.boot.logging.logback.WhitespaceThrowableProxyConverter" />
    <conversionRule conversionWord="wEx" class="org.springframework.boot.logging.logback.ExtendedWhitespaceThrowableProxyConverter" />

    <springProperty scope="context" name="APP_LOG_LEVEL" source="logging.level.com.sunflower.ctrllink" defaultValue="DEBUG" />
    <springProperty scope="context" name="ROOT_LOG_LEVEL" source="logging.level.root" defaultValue="INFO" />

    <!-- Docker-optimized Console Pattern with Timestamp, Level, Thread, MDC Request ID, MDC User ID, Logger, Message -->
    <property name="CONSOLE_LOG_PATTERN"
              value="%clr(%d{yyyy-MM-dd HH:mm:ss.SSS}){faint} %clr(%5p) %clr(---){faint} %clr([%15.15t]){faint} %clr([req=%X{requestId:-none}]){cyan} %clr([user=%X{userId:-anon}]){magenta} %clr(%-40.40logger{39}){cyan} %clr(:){faint} %m%n%wEx" />

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${CONSOLE_LOG_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- Specific noisy loggers suppressed to keep container logs readable -->
    <logger name="org.apache.tomcat.util.http.parser.Cookie" level="WARN" />
    <logger name="org.apache.coyote.http11.Http11Processor" level="ERROR" />
    <logger name="org.apache.catalina.core.ContainerBase" level="WARN" />

    <!-- CtrlLink Application Logger -->
    <logger name="com.sunflower.ctrllink" level="${APP_LOG_LEVEL}" additivity="false">
        <appender-ref ref="CONSOLE" />
    </logger>

    <!-- Root Logger -->
    <root level="${ROOT_LOG_LEVEL}">
        <appender-ref ref="CONSOLE" />
    </root>

</configuration>
